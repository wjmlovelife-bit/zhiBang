# 14a. 编辑器风格统一（2026-09-23 加）
# 装了 EditorConfig 插件的 IDE（VSCode/WebStorm）会自动套用，
# 解决跨平台 CRLF/LF 提交污染 diff、缩进风格不一致的问题。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TS/Vue 都按 2 空格；少数老文件若有 4 空格，可在该文件首行加 `// editorconfig-checker-disable-line`
[*.{ts,tsx,js,jsx,vue,html,scss,css,md,json}]
indent_size = 2

# Makefile/PowerShell 必须 Tab
[Makefile]
indent_style = tab

[*.ps1]
indent_style = tab