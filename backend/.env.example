# PG 数据源（Prisma 用）
DATABASE_URL=postgresql://zhibang_app:CHANGEME@localhost:5432/zhibang

# 服务端口
PORT=3001

# 上传目录（serve-frontend.mjs 静态服务的相对路径，/uploads/* → uploads/*）
UPLOAD_DIR=./uploads

# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=CHANGEME_min_32_chars_random
JWT_EXPIRES_IN=7d

# 日志级别（pino 6 级：fatal / error / warn / info / debug / trace）
# 生产：info（默认，只打业务关键事件 + 4xx/5xx）
# 调试：debug（额外打 Prisma SQL 日志，可能爆盘，不要在生产开）
# 告警：warn（只打警告 + 错误，磁盘最省）
LOG_LEVEL=info

# 慢告警阈值（ms）。超过则升级为 warn 级别日志
# 默认 2000ms（SQL + HTTP 统一阈值）；改小更敏感、改大更宽松
# SLOW_QUERY_MS=2000
# SLOW_REQUEST_MS=2000