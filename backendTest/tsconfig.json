{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "rootDirs": ["./src", "../backend/src"],
    "paths": {
      "@app/*": ["../backend/src/*"]
    }
  },
  "include": ["./src/**/*.ts", "../backend/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "../backend/node_modules"]
}
